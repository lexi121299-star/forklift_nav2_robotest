<!--
  ORU planner execution tree for the forklift migration.

  The ORU global planner is plan-once: compute one kinodynamic path, then let the
  ForkliftMpcController track it. The default Nav2 Foxy tree replans at 1 Hz,
  which can cancel an otherwise valid path when an intermediate footprint state
  is temporarily not replannable.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="2" name="NavigateRecovery">
      <Sequence name="PlanOnceThenFollow">
        <RecoveryNode number_of_retries="1" name="ComputePathToPose">
          <!--
            Foxy may otherwise retain the BT action node's 20 ms response
            timeout. Large-map departure fallback can legitimately take close
            to one second before the planner accepts the goal.
          -->
          <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased" server_timeout="5000"/>
          <Sequence name="RefreshGlobalCostmap">
            <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap" server_timeout="5000"/>
            <Wait wait_duration="1" server_timeout="5000"/>
          </Sequence>
        </RecoveryNode>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="FollowPath" server_timeout="5000"/>
          <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap" server_timeout="5000"/>
        </RecoveryNode>
      </Sequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <Sequence name="RecoveryActions">
          <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap" server_timeout="5000"/>
          <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap" server_timeout="5000"/>
          <Wait wait_duration="1" server_timeout="5000"/>
        </Sequence>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
