<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="forklift_diff_drive">
  <xacro:arg name="gazebo_cmd_vel_topic" default="cmd_vel"/>
  <xacro:arg name="gazebo_scan_topic" default="scan"/>

  <!-- 2MKC20M30LV205 geometry. base_link is the drive-axle center and -X points to the forks. -->
  <xacro:property name="drive_wheel_radius" value="0.2285"/>
  <xacro:property name="drive_wheel_width" value="0.178"/>
  <xacro:property name="drive_track_width" value="0.937"/>
  <xacro:property name="support_wheel_radius" value="0.1905"/>
  <xacro:property name="support_wheel_width" value="0.127"/>
  <xacro:property name="support_track_width" value="0.183"/>
  <xacro:property name="wheel_base" value="1.40"/>
  <xacro:property name="base_z" value="${drive_wheel_radius}"/>
  <xacro:property name="body_length" value="2.079"/>
  <xacro:property name="body_width" value="1.220"/>
  <xacro:property name="body_center_x" value="0.6695"/>
  <xacro:property name="mast_x" value="-0.370"/>
  <xacro:property name="fork_length" value="1.220"/>
  <xacro:property name="fork_center_x" value="-0.980"/>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="${body_center_x} 0 0"/>
      <mass value="28.0"/>
      <inertia ixx="1.20" ixy="0.0" ixz="0.0" iyy="3.40" iyz="0.0" izz="3.80"/>
    </inertial>
    <visual name="body_visual">
      <origin xyz="${body_center_x} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} 0.26"/>
      </geometry>
      <material name="forklift_yellow">
        <color rgba="1.0 0.68 0.10 1.0"/>
      </material>
    </visual>
    <collision name="body_collision">
      <origin xyz="${body_center_x} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} 0.26"/>
      </geometry>
    </collision>

    <visual name="counterweight_visual">
      <origin xyz="1.55 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.318 1.12 0.34"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.08 0.09 0.10 1.0"/>
      </material>
    </visual>
    <collision name="counterweight_collision">
      <origin xyz="1.55 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.318 1.12 0.34"/>
      </geometry>
    </collision>

    <visual name="mast_visual">
      <origin xyz="${mast_x} 0 0.835" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.97 1.917"/>
      </geometry>
      <material name="mast_gray">
        <color rgba="0.18 0.20 0.22 1.0"/>
      </material>
    </visual>
    <collision name="mast_collision">
      <origin xyz="${mast_x} 0 0.835" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.97 1.917"/>
      </geometry>
    </collision>

    <visual name="fork_left_visual">
      <origin xyz="${fork_center_x} 0.25 -0.1885" rpy="0 0 0"/>
      <geometry>
        <box size="${fork_length} 0.10 0.04"/>
      </geometry>
      <material name="fork_gray">
        <color rgba="0.32 0.34 0.35 1.0"/>
      </material>
    </visual>
    <collision name="fork_left_collision">
      <origin xyz="${fork_center_x} 0.25 -0.1885" rpy="0 0 0"/>
      <geometry>
        <box size="${fork_length} 0.10 0.04"/>
      </geometry>
    </collision>

    <visual name="fork_right_visual">
      <origin xyz="${fork_center_x} -0.25 -0.1885" rpy="0 0 0"/>
      <geometry>
        <box size="${fork_length} 0.10 0.04"/>
      </geometry>
      <material name="fork_gray"/>
    </visual>
    <collision name="fork_right_collision">
      <origin xyz="${fork_center_x} -0.25 -0.1885" rpy="0 0 0"/>
      <geometry>
        <box size="${fork_length} 0.10 0.04"/>
      </geometry>
    </collision>
  </link>

  <link name="left_wheel_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.018" ixy="0.0" ixz="0.0" iyy="0.032" iyz="0.0" izz="0.018"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="${drive_wheel_radius}" length="${drive_wheel_width}"/>
      </geometry>
      <material name="wheel_black">
        <color rgba="0.02 0.02 0.02 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="${drive_wheel_radius}" length="${drive_wheel_width}"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 ${drive_track_width / 2.0} 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="right_wheel_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.018" ixy="0.0" ixz="0.0" iyy="0.032" iyz="0.0" izz="0.018"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="${drive_wheel_radius}" length="${drive_wheel_width}"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="${drive_wheel_radius}" length="${drive_wheel_width}"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 ${-drive_track_width / 2.0} 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="left_support_wheel_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="${support_wheel_radius}" length="${support_wheel_width}"/>
      </geometry>
      <material name="caster_dark">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="${support_wheel_radius}" length="${support_wheel_width}"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_support_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_support_wheel_link"/>
    <origin xyz="${wheel_base} ${support_track_width / 2.0} ${support_wheel_radius - drive_wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="right_support_wheel_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="${support_wheel_radius}" length="${support_wheel_width}"/>
      </geometry>
      <material name="caster_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="${support_wheel_radius}" length="${support_wheel_width}"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_support_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_support_wheel_link"/>
    <origin xyz="${wheel_base} ${-support_track_width / 2.0} ${support_wheel_radius - drive_wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_scan">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.065" length="0.055"/>
      </geometry>
      <material name="laser_blue">
        <color rgba="0.05 0.24 0.80 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.065" length="0.055"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_scan_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_scan"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <gazebo reference="base_link">
    <material>Gazebo/Yellow</material>
  </gazebo>

  <gazebo reference="left_wheel_link">
    <material>Gazebo/Black</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="right_wheel_link">
    <material>Gazebo/Black</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="left_support_wheel_link">
    <material>Gazebo/Black</material>
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>

  <gazebo reference="right_support_wheel_link">
    <material>Gazebo/Black</material>
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>

  <gazebo reference="base_scan">
    <sensor name="forklift_laser" type="ray">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="forklift_laserscan" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=$(arg gazebo_scan_topic)</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>base_scan</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin name="forklift_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <remapping>cmd_vel:=$(arg gazebo_cmd_vel_topic)</remapping>
      </ros>
      <update_rate>50</update_rate>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${drive_track_width}</wheel_separation>
      <wheel_diameter>${2.0 * drive_wheel_radius}</wheel_diameter>
      <max_wheel_torque>80</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>

    <plugin name="forklift_joint_state" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <remapping>~/out:=joint_states</remapping>
      </ros>
      <update_rate>50</update_rate>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>
</robot>
