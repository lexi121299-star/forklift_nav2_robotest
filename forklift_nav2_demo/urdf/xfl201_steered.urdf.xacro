<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="xfl201_steered">
  <xacro:arg name="gazebo_cmd_vel_topic" default="cmd_vel"/>
  <xacro:arg name="gazebo_scan_topic" default="scan"/>

  <xacro:property name="wheel_radius" value="0.15"/>
  <xacro:property name="wheel_width" value="0.08"/>
  <xacro:property name="wheel_separation" value="0.86"/>
  <xacro:property name="base_z" value="0.22"/>
  <xacro:property name="body_length" value="2.10"/>
  <xacro:property name="body_width" value="1.076"/>
  <xacro:property name="body_height" value="0.32"/>
  <xacro:property name="body_center_x" value="0.616"/>
  <xacro:property name="fork_vertical_face_x" value="-0.434"/>
  <xacro:property name="fork_length" value="1.070"/>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="28.0"/>
      <inertia ixx="1.20" ixy="0.0" ixz="0.0" iyy="3.40" iyz="0.0" izz="3.80"/>
    </inertial>
    <visual name="body_visual">
      <origin xyz="${body_center_x} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <material name="forklift_yellow">
        <color rgba="1.0 0.68 0.10 1.0"/>
      </material>
    </visual>
    <collision name="body_collision">
      <origin xyz="${body_center_x} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </collision>

    <visual name="counterweight_visual">
      <origin xyz="1.45 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.40 ${body_width} 0.38"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.08 0.09 0.10 1.0"/>
      </material>
    </visual>
    <collision name="counterweight_collision">
      <origin xyz="1.45 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.40 ${body_width} 0.38"/>
      </geometry>
    </collision>

    <visual name="mast_visual">
      <origin xyz="${fork_vertical_face_x} 0 0.82" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.95 1.80"/>
      </geometry>
      <material name="mast_gray">
        <color rgba="0.18 0.20 0.22 1.0"/>
      </material>
    </visual>
    <collision name="mast_collision">
      <origin xyz="${fork_vertical_face_x} 0 0.82" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.95 1.80"/>
      </geometry>
    </collision>

    <visual name="fork_left_visual">
      <origin xyz="${fork_vertical_face_x - fork_length / 2.0} 0.25 -0.13" rpy="0 0 0"/>
      <geometry>
        <box size="${fork_length} 0.122 0.04"/>
      </geometry>
      <material name="fork_gray">
        <color rgba="0.32 0.34 0.35 1.0"/>
      </material>
    </visual>
    <collision name="fork_left_collision">
      <origin xyz="${fork_vertical_face_x - fork_length / 2.0} 0.25 -0.13" rpy="0 0 0"/>
      <geometry>
        <box size="${fork_length} 0.122 0.04"/>
      </geometry>
    </collision>

    <visual name="fork_right_visual">
      <origin xyz="${fork_vertical_face_x - fork_length / 2.0} -0.25 -0.13" rpy="0 0 0"/>
      <geometry>
        <box size="${fork_length} 0.122 0.04"/>
      </geometry>
      <material name="fork_gray"/>
    </visual>
    <collision name="fork_right_collision">
      <origin xyz="${fork_vertical_face_x - fork_length / 2.0} -0.25 -0.13" rpy="0 0 0"/>
      <geometry>
        <box size="${fork_length} 0.122 0.04"/>
      </geometry>
    </collision>
  </link>

  <link name="left_wheel_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.018" ixy="0.0" ixz="0.0" iyy="0.032" iyz="0.0" izz="0.018"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="wheel_black">
        <color rgba="0.02 0.02 0.02 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 ${wheel_separation / 2.0} -0.06" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="right_wheel_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.018" ixy="0.0" ixz="0.0" iyy="0.032" iyz="0.0" izz="0.018"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 ${-wheel_separation / 2.0} -0.06" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="steer_wheel_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry>
        <sphere radius="0.07"/>
      </geometry>
      <material name="caster_dark">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.07"/>
      </geometry>
    </collision>
  </link>

  <joint name="steer_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="steer_wheel_link"/>
    <origin xyz="1.47 0 -0.15" rpy="0 0 0"/>
  </joint>

  <link name="base_scan">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.065" length="0.055"/>
      </geometry>
      <material name="laser_blue">
        <color rgba="0.05 0.24 0.80 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.065" length="0.055"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_scan_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_scan"/>
    <origin xyz="1.25 0 0.30" rpy="0 0 0"/>
  </joint>

  <gazebo reference="base_link">
    <material>Gazebo/Yellow</material>
  </gazebo>

  <gazebo reference="left_wheel_link">
    <material>Gazebo/Black</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="right_wheel_link">
    <material>Gazebo/Black</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="steer_wheel_link">
    <material>Gazebo/Black</material>
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>

  <gazebo reference="base_scan">
    <sensor name="forklift_laser" type="ray">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="forklift_laserscan" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=$(arg gazebo_scan_topic)</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>base_scan</frame_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>
